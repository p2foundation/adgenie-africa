# The NestJS API is the only backend the browser talks to (ADR-0002).
# Requests are sent with credentials: "include" so the session cookie travels.
#
# Local: the API runs beside the web app on :4000.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Deployed (Vercel): the browser must call this same origin, not the API host,
# or the HttpOnly session cookie becomes a cross-site cookie and is dropped. Set:
#   NEXT_PUBLIC_API_URL=/api/v1
#   API_ORIGIN=https://adgenie-api.onrender.com   (server-only, never public)
# next.config.mjs rewrites /api/v1/* to API_ORIGIN, so cookies stay first-party.
# Leave API_ORIGIN unset locally; it is only read on the server.
API_ORIGIN=

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=AdGenie Africa

# Public contact details shown in the footer and on the policy pages.
# The WhatsApp number is digits only, with country code and no plus sign
# (0593998216 as dialled locally becomes 233593998216).
NEXT_PUBLIC_SUPPORT_EMAIL=d4.mcom@gmail.com
NEXT_PUBLIC_WHATSAPP_NUMBER=233593998216